db <- read.csv(dir_data,encoding = "UTF-8", stringsAsFactors = FALSE)


str(db)





db$ENTIDAD <- str_pad(string = db$ENTIDAD, width = 2, side = "left", pad = 0)
db$MUN <- str_pad(string = db$MUN, width = 3, side = "left", pad = 0)
db$LOC <- str_pad(string = db$LOC, width = 4, side = "left", pad = 0)
db$MZA <- str_pad(string = db$MZA, width = 3, side = "left", pad = 0)





# str(db)





db<- unite(data = db, col = CVEGEO, c('ENTIDAD', 'MUN', 'LOC', 'AGEB'), sep = "", remove = FALSE)





str(db)





############# Array de Población:total ##################
#Hacemos un filtro solo para los valores de población total
db_T<- db %>% filter(NOM_LOC== "Total AGEB urbana")





db_T[db_T=="*"] <- ""


db_T<- db_T %>% mutate_at(vars(c(9:ncol(db))), as.numeric)





# A los valores con NA les asignamos el valor de cero
db_T[is.na(db_T)] <- 0


str(db_T)








Ent <- db %>% filter(NOM_LOC== "Total de la entidad")














capa_ageb <- read_sf(dir_shp)





capa_ageb <- st_transform(capa_ageb, "+proj=longlat +datum=WGS84 +no_defs")





capa_ageb$area_km2 <- st_area(capa_ageb) / 10^6
#convertir el tipo de columna
capa_ageb$area_km2 <- as.numeric(capa_ageb$area_km2)





# Coordenadas del centro de la zona de interes, cambiar
latitud <- 25.542485
longitud <- -103.396506
zoom <- 11  # Nivel de zoom deseado

# Crear una paleta de colores para representar la población de las AGEB
pal <- colorQuantile("Blues", domain = capa_ageb$area_km2, n=5)

# Crear un mapa interactivo con Leaflet
mapa <- leaflet(capa_ageb) %>%
  addTiles() %>%
  addPolygons(
    fillColor =  ~pal(area_km2),
    fillOpacity = 0.5,
    color = "black",
    weight = 1,
    popup = ~paste("Área:", round(area_km2,3), "km²"), # Muestra los datos al hacer clic en un polígono
    label = ~CVE_AGEB # Indica el nombre al poner el cursor
  ) %>%
  addLegend(
    pal = pal,
    values = ~area_km2,
    title = "Área en kilómetros cuadrados",
    opacity = 1,
    position = "bottomright"  # Cambia la posición de la leyenda si es necesario
  ) %>%
  setView(lng = longitud, lat = latitud, zoom = zoom)  # Establece el centro y el nivel de zoom

