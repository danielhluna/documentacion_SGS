# calculo del porcentaje de poblacion sin servicios de salud
VSE1 <- (capa_ageb$PSINDER/Ent$POBTOT)*100
summary(VSE1)
#Nomalizacion por minimos y maximos, sirve para escalar los datos u esten entre 0 y 1, y despues usar el peso
VSE1N <- (VSE1 - min(VSE1))/ (max(VSE1) - min(VSE1))
#Multiplicando por el peso correspondiente y guardandolo en el shape
capa_ageb$VS1 <- VSE1N*0.069


#capa_ageb$VS1





VSE2 <- ((capa_ageb$P8A14AN + capa_ageb$P15YM_AN)/Ent$POBTOT)*100

#Nomalizacion por minimos y maximos, sirve para escalar los datos u estén entre 0 y 1, y después usar el peso
VSE2N <- (VSE2 - min(VSE2))/ (max(VSE2) - min(VSE2))
#Multiplicando por el peso correspondiente y guardandolo en el shape
capa_ageb$VS2 <- VSE2N*0.80


#VSE2N





VSE3 <- ((capa_ageb$P6A11_NOA + capa_ageb$P12A14NOA)/Ent$POBTOT)*100

#Nomalizacion por minimos y maximos, sirve para escalar los datos u esten entre 0 y 1, y despues usar el peso
VSE3N <- (VSE3 - min(VSE3))/ (max(VSE3) - min(VSE3))
#Multiplicando por el peso correspondiente y guardandolo en el shape
capa_ageb$VS3 <- VSE3N*0.065


#capa_ageb$VS3





VSE4 <- ((capa_ageb$VPH_SINRTV + capa_ageb$VPH_SINLTC + 
         capa_ageb$VPH_SINCINT + capa_ageb$VPH_SINTIC)/ as.integer(Ent$TVIVPARHAB))*100

#Nomalizacion por minimos y maximos, sirve para escalar los datos u esten entre 0 y 1, y despues usar el peso
VSE4N <- (VSE4 - min(VSE4))/ (max(VSE4) - min(VSE4))
#Multiplicando por el peso correspondiente y guardandolo en el shape
capa_ageb$VS4 <- VSE4N*0.110


#capa_ageb$VS4





VSE5 <- capa_ageb$GRAPROES

#Nomalizacion por minimos y maximos, sirve para escalar los datos u esten entre 0 y 1, y despues usar el peso
VSE5N <- (VSE5 - min(VSE5))/ (max(VSE5) - min(VSE5))
#Multiplicando por el peso correspondiente y guardandolo en el shape
capa_ageb$VS5 <- VSE5N*0.107


#capa_ageb$VS5





VSE6 <- (capa_ageb$VPH_NDEAED/ as.integer(Ent$TVIVPARHAB))*100

#Nomalizacion por minimos y maximos, sirve para escalar los datos u esten entre 0 y 1, y despues usar el peso
VSE6N <- (VSE6 - min(VSE6))/ (max(VSE6) - min(VSE6))
#Multiplicando por el peso correspondiente y guardandolo en el shape
capa_ageb$VS6 <- VSE6N*0.117


#capa_ageb$VS6





VSE7 <- (capa_ageb$VPH_PISOTI/ as.integer(Ent$TVIVPARHAB))*100

#Nomalizacion por minimos y maximos, sirve para escalar los datos u esten entre 0 y 1, y despues usar el peso
VSE7N <- (VSE7 - min(VSE7))/ (max(VSE7) - min(VSE7))
#Multiplicando por el peso correspondiente y guardandolo en el shape
capa_ageb$VS7 <- VSE7N*0.058


#capa_ageb$VS7





VSE8 <- capa_ageb$PRO_OCUP_C

#Nomalizacion por minimos y maximos, sirve para escalar los datos u esten entre 0 y 1, y despues usar el peso
VSE8N <- (VSE8 - min(VSE8))/ (max(VSE8) - min(VSE8))
#Multiplicando por el peso correspondiente y guardandolo en el shape
capa_ageb$VS8 <- VSE8N*0.087


#capa_ageb$VS8





VSE9 <- (capa_ageb$PE_INAC/ (capa_ageb$PEA + capa_ageb$PE_INAC))*100

VSE9[is.na(VSE9)] <- 0

#Reemplaza los valores infinitos por 0
VSE9[VSE9 == Inf] <- 0

#Nomalizacion por minimos y maximos, sirve para escalar los datos u esten entre 0 y 1, y despues usar el peso
VSE9N <- (VSE9 - min(VSE9))/ (max(VSE9) - min(VSE9))
#Multiplicando por el peso correspondiente y guardandolo en el shape
capa_ageb$VS9 <- VSE9N*0.040


#capa_ageb$VS9





VSE10 <- capa_ageb$POBTOT/ capa_ageb$area_km2

#Nomalizacion por minimos y maximos, sirve para escalar los datos u esten entre 0 y 1, y despues usar el peso
VSE10N <- (VSE10 - min(VSE10))/ (max(VSE10) - min(VSE10))
#Multiplicando por el peso correspondiente y guardandolo en el shape
capa_ageb$VS10 <- VSE10N*0.107


#capa_ageb$VS10 





VSE11 <- (capa_ageb$P5_HLI/Ent$POBTOT)*100

#Nomalizacion por minimos y maximos, sirve para escalar los datos u esten entre 0 y 1, y despues usar el peso
VSE11N <- (VSE11 - min(VSE11))/ (max(VSE11) - min(VSE11))
#Multiplicando por el peso correspondiente y guardandolo en el shape
capa_ageb$VS11 <- VSE11N*0.055


#capa_ageb$VS11





# calculo del porcentaje de la poblacion con discapacidad
VSE12 <- ((capa_ageb$PCON_DISC + capa_ageb$PCON_LIMI)/Ent$POBTOT)*100

#Nomalizacion por minimos y maximos, sirve para escalar los datos u esten entre 0 y 1, y despues usar el peso
VSE12N <- (VSE12 - min(VSE12))/ (max(VSE12) - min(VSE12))
#Multiplicando por el peso correspondiente y guardandolo en el shape
capa_ageb$VS12 <- VSE12N*0.074


#capa_ageb$VS12 





VSE13 <- (capa_ageb$PHOGJEF_F/as.integer(Ent$POBHOG))*100

#Nomalizacion por minimos y maximos, sirve para escalar los datos u esten entre 0 y 1, y despues usar el peso
VSE13N <- (VSE13 - min(VSE13))/ (max(VSE13) - min(VSE13))
#Multiplicando por el peso correspondiente y guardandolo en el shape
capa_ageb$VS13 <- VSE13N*0.030


#capa_ageb$VS13





capa_ageb$VST <- (capa_ageb$VS1 + capa_ageb$VS2 + capa_ageb$VS3 + capa_ageb$VS4 + capa_ageb$VS5 
                  + capa_ageb$VS6 + capa_ageb$VS7 + capa_ageb$VS8 + capa_ageb$VS9 + capa_ageb$VS10 
                  + capa_ageb$VS11 + capa_ageb$VS12 + capa_ageb$VS13)


#capa_ageb$VST


# Se revisa el tipo de archivo de la capa
#class(capa_ageb)








# Calcular las clases con el método de Jenks
clases_jenks <- classIntervals(capa_ageb$VST, n = 5, style = "jenks")

# Imprimir los límites de las clases
print(clases_jenks$brks)





# Etiquetas para las clases
etiquetas_clases <- c("Muy baja", "Baja", "Moderada", "Alta", "Muy alta")

# Asignar etiquetas a las clases
capa_ageb$NOM_VST <- etiquetas_clases[findInterval(capa_ageb$VST, clases_jenks$brks, all.inside = TRUE)]

#Etiquetas numericas
# Etiquetas para las clases
etiquetas_clases2 <- c("1", "2", "3", "4", "5")

# Asignar etiquetas a las clases
capa_ageb$NUM_VST <- as.numeric(etiquetas_clases2[findInterval(capa_ageb$VST, clases_jenks$brks, all.inside = TRUE)])






