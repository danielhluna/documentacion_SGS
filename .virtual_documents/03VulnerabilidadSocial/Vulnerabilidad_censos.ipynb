############# Selección de los AGEBS ##################
#Hacemos un filtro solo para los valores de AGEB urbana
db <- db %>% filter(NOM_LOC== "Total AGEB urbana")


# Cambio de caracteres para que los asteriscos queden como NA
db[db == "*"] <- ""


db <- db %>% mutate_at(vars(c(9:ncol(db))), as.numeric)
# función para cambiar los valores de doble a entero
#db <- db %>% mutate_at(vars(c(9:ncol(db))), as.integer)





head(db, 4)


db$ENTIDAD <- str_pad(string = db$ENTIDAD, width = 2, side = "left", pad = 0)
db$MUN <- str_pad(string = db$MUN, width = 3, side = "left", pad = 0)
db$LOC <- str_pad(string = db$LOC, width = 4, side = "left", pad = 0)
db$MZA <- str_pad(string = db$MZA, width = 3, side = "left", pad = 0)
db<- unite(data = db, col = CVEGEO, c('ENTIDAD', 'MUN', 'LOC', 'AGEB'), sep = "", remove = FALSE)


head(db, 10)


Ent <- db %>% filter(NOM_LOC== "Total de la entidad")





capa_ageb <- read_sf(dir_shp)
capa_ageb <- st_transform(capa_ageb, "+proj=longlat +datum=WGS84 +no_defs")


capa_ageb$area_km2 <- st_area(capa_ageb) / 10^6
#convertir el tipo de columna
capa_ageb$area_km2 <- as.numeric(capa_ageb$area_km2)


# Coordenadas del centro de la zona de interes, cambiar
latitud <- 22.155152
longitud <- -100.974473
zoom <- 11  # Nivel de zoom deseado



# Crear una paleta de colores para representar la población de las AGEB
pal <- colorQuantile("Blues", domain = capa_ageb$area_km2, n=5)

# Crear un mapa interactivo con Leaflet
mapa <- leaflet(capa_ageb) %>%
  addTiles() %>%
  addPolygons(
    fillColor =  ~pal(area_km2),
    fillOpacity = 0.5,
    color = "black",
    weight = 1,
    popup = ~paste("Área:", round(area_km2,3), "km²"), # Muestra los datos al hacer clic en un polígono
    label = ~CVEGEO # Indica el nombre al poner el cursor
  ) %>%
  addLegend(
    pal = pal,
    values = ~area_km2,
    title = "Área en kilómetros cuadrados",
    opacity = 1,
    position = "bottomright"  # Cambia la posición de la leyenda si es necesario
  ) %>%
  setView(lng = longitud, lat = latitud, zoom = zoom)  # Establece el centro y el nivel de zoom

# Establecer la altura del mapa en 600px
mapa <- htmlwidgets::onRender(mapa, '
  function(el, x) {
    $(el).css("height", "800px");
  }
')

# Agregar un título utilizando etiquetas HTML en la leyenda
mapa <- mapa %>% 
  addControl(
    html = '<div style="text-align: center; background-color: #fff; padding: 10px;"><h3>Mapa de las AGEB de San Luis</h3></div>',
    position = "topright"  # Cambia la posición del título si es necesario
  )

# Mostrar el mapa interactivo
mapa





# Unir las dos tablas
capa_ageb <- capa_ageb %>%
  left_join(db, by="CVEGEO")


# Filtrar las filas que no tienen coincidencia en db_T y el shape file del AGEB
# se deja solo las coincidencias de la clave CVEGEO
capa_ageb <- capa_ageb %>%
  filter(NOM_LOC== "Total AGEB urbana")


# Crear una paleta de colores para representar la población de las AGEB
pal <- colorQuantile("YlOrRd", domain = capa_ageb$POBTOT, n=5)

# Crear un mapa interactivo con Leaflet
mapa <- leaflet(capa_ageb) %>%
  addTiles() %>%
  addPolygons(
    fillColor =  ~pal(POBTOT),
    fillOpacity = 0.5,
    color = "black",
    weight = 1,
    popup = ~paste("Población: ", POBTOT, " habitantes", "<br>", "AGEB: ", AGEB, "<br>", "Municipio: ", NOM_MUN),
    label = ~NOM_MUN
  ) %>%
  addLegend(
    pal = pal,
    values = ~POBTOT,
    title = "Densidad de Población",
    opacity = 1,
    position = "bottomright"
  ) %>%
  setView(lng = longitud, lat = latitud, zoom = zoom)  # Establece el centro y el nivel de zoom

# Establecer la altura del mapa en 600px
mapa <- htmlwidgets::onRender(mapa, '
  function(el, x) {
    $(el).css("height", "800px");
  }
')


# Agregar un título utilizando etiquetas HTML en la leyenda
mapa <- mapa %>% 
