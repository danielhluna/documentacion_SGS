nor_mm <- function(x) {
  rng <- range(x, na.rm = TRUE, finite = TRUE)
  (x - rng[1]) / (rng[2] - rng[1])
}


#Variables necesarias
Viviendas_total <- sum(db$Total.de.viviendas.habitadas,na.rm = TRUE)
pob_total <- sum(db$Población.total, na.rm = TRUE)

#INDICE 1
pob_total <- sum(db$Población.total, na.rm = TRUE)
VSE1 <- (capa_ageb$Población.sin.derechohabiencia.a.servicios.de.salud/pob_total)*100
# Normalización usando la función nor_mm (mínimo-máximo)
VSE1N <- nor_mm(VSE1)
# Multiplicando por el peso correspondiente y guardándolo en el shape
capa_ageb$VS1 <- VSE1N*0.069

#INDICE 2
VSE2 <- ((capa_ageb$Población.de.8.a.14.años.que.no.sabe.leer.y.escribir +
capa_ageb$Población.de.15.años.y.más.analfabeta) / pob_total)*100
# Normalización usando la función nor_mm (mínimo-máximo)
VSE2N <- nor_mm(VSE2)
# Multiplicando por el peso correspondiente y guardándolo en el shape
capa_ageb$VS2 <- VSE2N*0.80

#INDICE 3
VSE3 <- ((capa_ageb$Población.de.6.a.14.años.que.no.asiste.a.la.escuela) / pob_total)*100
# Normalización usando la función nor_mm (mínimo-máximo)
VSE3N <- nor_mm(VSE3)
# Multiplicando por el peso correspondiente y guardándolo en el shape
capa_ageb$VS3 <- VSE3N*0.065

#INDICE 4
VSE4 <- (((capa_ageb$Viviendas.particulares.habitadas - 
capa_ageb$Viviendas.particulares.habitadas.que.disponen.de.televisión) +
(capa_ageb$Viviendas.particulares.habitadas - 
capa_ageb$Viviendas.particulares.habitadas.que.disponen.de.computadora) +
(capa_ageb$Viviendas.particulares.habitadas -
capa_ageb$Viviendas.particulares.habitadas.que.disponen.de.refrigerador)) / Viviendas_total)*100
# Normalización usando la función nor_mm (mínimo-máximo)
VSE4N <- nor_mm(VSE4)
# Multiplicando por el peso correspondiente y guardándolo en el shape
capa_ageb$VS4 <- VSE4N*0.110

#INDICE 5
VSE5 <- capa_ageb$Grado.promedio.de.escolaridad
# Normalización usando la función nor_mm (mínimo-máximo)
VSE5N <- nor_mm(VSE5)
# Multiplicando por el peso correspondiente y guardándolo en el shape
capa_ageb$VS5 <- VSE5N*0.107

#INDICE 6
VSE6 <- (capa_ageb$Viviendas.particulares.habitadas.sin.ningún.bien / Viviendas_total)*100
# Normalización usando la función nor_mm (mínimo-máximo)
VSE6N <- nor_mm(VSE6)
# Multiplicando por el peso correspondiente y guardándolo en el shape
capa_ageb$VS6 <- VSE6N*0.117

#INDICE 7
VSE7 <- (capa_ageb$Viviendas.particulares.habitadas.que.no.disponen.de.agua.entubada.a.la.red.pública..drenaje.y.energía.eléctrica/ Viviendas_total)*100
# Normalización usando la función nor_mm (mínimo-máximo)
VSE7N <- nor_mm(VSE7)
# Multiplicando por el peso correspondiente y guardándolo en el shape
capa_ageb$VS7 <- VSE7N*0.058

#INDICE 8 
VSE8 <- capa_ageb$Promedio.de.ocupantes.por.cuarto.en.viviendas.particulares.habitadas
# Normalización usando la función nor_mm (mínimo-máximo)
VSE8N <- nor_mm(VSE8)
# Multiplicando por el peso correspondiente y guardándolo en el shape
capa_ageb$VS8 <- VSE8N*0.087

#INDICE 9
# NO EXISTEN LAS VARIABLES EN EL CENSO 2005 PARA ESTE ÍNDICE
# PESO DE LA VARIABLE 0.040

#INDICE 10
VSE10 <- (capa_ageb$Total.de.viviendas.habitadas / capa_ageb$area_km2)
# Normalización usando la función nor_mm (mínimo-máximo)
VSE10N <- nor_mm(VSE10)
# Multiplicando por el peso correspondiente y guardándolo en el shape
capa_ageb$VS10 <- VSE10N*0.107

#INDICE 11
VSE11 <- (capa_ageb$Población.de.5.años.y.más.que.habla.alguna.lengua.indígena / pob_total)*100
# Normalización usando la función nor_mm (mínimo-máximo)
VSE11N <- nor_mm(VSE11)
# Multiplicando por el peso correspondiente y guardándolo en el shape
capa_ageb$VS11 <- VSE11N*0.055

#INDICE 12
# NO EXISTEN LAS VARIABLES EN EL CENSO 2005 PARA ESTE ÍNDICE
# PESO DE LA VARIABLE 0.074

#INDICE 13
VSE13 <- (capa_ageb$Hogares.con.jefatura.femenina / capa_ageb$Total.de.hogares)*100
# Normalización usando la función nor_mm (mínimo-máximo)
VSE13N <- nor_mm(VSE13)
# Multiplicando por el peso correspondiente y guardándolo en el shape
capa_ageb$VS13 <- VSE13N*0.030



capa_ageb$VST <- (capa_ageb$VS1 + capa_ageb$VS2 + capa_ageb$VS3 + capa_ageb$VS4 + capa_ageb$VS5 
                  + capa_ageb$VS6 + capa_ageb$VS7 + capa_ageb$VS8  + capa_ageb$VS10 
                  + capa_ageb$VS11 + capa_ageb$VS13)


capa_ageb$VS5


# Calcular las clases con el método de Jenks
clases_jenks <- classIntervals(capa_ageb$VST, n = 5, style = "jenks")

# Imprimir los límites de las clases
print(clases_jenks$brks)

# Etiquetas para las clases
etiquetas_clases <- c("Muy baja", "Baja", "Moderada", "Alta", "Muy alta")

# Asignar etiquetas a las clases
capa_ageb$NOM_VST <- etiquetas_clases[findInterval(capa_ageb$VST, clases_jenks$brks, all.inside = TRUE)]

#Etiquetas numericas
# Etiquetas para las clases
etiquetas_clases2 <- c("1", "2", "3", "4", "5")

# Asignar etiquetas a las clases
capa_ageb$NUM_VST <- as.numeric(etiquetas_clases2[findInterval(capa_ageb$VST, clases_jenks$brks, all.inside = TRUE)])


# Definir las etiquetas cualitativas
labels <- c("Muy Baja", "Baja", "Moderada", "Alta", "Muy Alta")

# Crear un mapa interactivo con Leaflet
bins <- clases_jenks$brks  # Ruptura de Jenks
pal <- colorBin("RdYlGn", domain = capa_ageb$VST, bins = bins, reverse = TRUE)

mapa <- leaflet(capa_ageb) %>%
  addTiles() %>%
  addPolygons(
    fillColor = ~pal(VST),
    weight = 1,
    opacity = 1,
    color = "black",
    dashArray = "4",
    fillOpacity = 0.6,
    highlightOptions = highlightOptions(
      weight = 5,
      color = "#666",
      dashArray = "",
      fillOpacity = 0.7,
      bringToFront = TRUE
    ),
    popup = ~paste("AGEB: ", CLAVE, "<br>", 
                   "Municipio: ", NOM_MUN, "<br>", 
                   "Población: ", Población.total, " habitantes", "<br>", 
                   "Área:", round(area_km2, 3), "km²"),
    label = ~NOM_VST,
    labelOptions = labelOptions(
      style = list("font-weight" = "normal", padding = "2px 6px"),
      textsize = "12px",
      direction = "auto"
    )
  ) %>%
  # Modificar la leyenda para mostrar etiquetas personalizadas
  addLegend(
    colors = pal(bins[-length(bins)]),  # Colores según los intervalos de Jenks
    labels = labels,  # Usar etiquetas cualitativas en la leyenda
    title = "Vulnerabilidad",
    opacity = 1,
    position = "bottomright"
  )%>%
  setView(lng = longitud, lat = latitud, zoom = zoom)  # Establece el centro y el nivel de zoom

