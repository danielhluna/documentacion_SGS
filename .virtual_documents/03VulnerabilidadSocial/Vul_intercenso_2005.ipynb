





dir_shp <- "/home/dan/Documentos/documentacion_SGS/03VulnerabilidadSocial/Jal/shp"
archivo_shp <- "AGEB_JAL_2005.shp"
dir_shp <- file.path(dir_shp, archivo_shp)b


dir <- "/home/dan/Documentos/documentacion_SGS/03VulnerabilidadSocial/Jal/datos"
archivo <- "ITERxAgeb2005.csv"
dir_data <- file.path(dir, archivo)


# Cargar librerías
library(tidyverse)
library(stringr)

#cargar las bibliotecas para lectura Shapefile
library(sf)
#library(rgeos)

#cargar las bibliotecas para la generación de mapas
library(leaflet)


db <- read.csv(dir_data, encoding = "UTF-8", stringsAsFactors = FALSE)
head(db,4)


#Leer el shapefile
capa_ageb <- read_sf(dir_shp)
#capa_ageb <- st_transform(capa_ageb, "+proj=longlat +datum=WGS84 +no_defs")
#Calculo del area
capa_ageb$area_km2 <- st_area(capa_ageb) / 10^6
#convertir el tipo de columna
capa_ageb$area_km2 <- as.numeric(capa_ageb$area_km2)


# Opción 1: mapa simple (límites)
library(ggplot2)
ggplot() +
  geom_sf(data = capa_ageb, fill = NA, color = "grey40", size = 0.2) +
  theme_minimal() +
  labs(title = "AGEBs - AMG (2005)")



names(capa_ageb)





# Coordenadas del centro de la zona de interes, cambiar
latitud <- 20.634513960782602
longitud <- -103.41533808846232
zoom <- 11  # Nivel de zoom deseado


# Crear una paleta de colores para representar la población de las AGEB
pal <- colorQuantile("Blues", domain = capa_ageb$area_km2, n=5)

# Crear un mapa interactivo con Leaflet
mapa <- leaflet(capa_ageb) %>%
  addTiles() %>%
  addPolygons(
    fillColor =  ~pal(area_km2),
    fillOpacity = 0.5,
    color = "black",
    weight = 1,
    popup = ~paste("Área:", round(area_km2,3), "km²"), # Muestra los datos al hacer clic en un polígono
    label = ~CLAVE # Indica el nombre al poner el cursor
  ) %>%
  addLegend(
    pal = pal,
    values = ~area_km2,
    title = "Área en kilómetros cuadrados",
    opacity = 1,
    position = "bottomright"  # Cambia la posición de la leyenda si es necesario
  ) %>%
  setView(lng = longitud, lat = latitud, zoom = zoom)  # Establece el centro y el nivel de zoom

# Agregar un título utilizando etiquetas HTML en la leyenda
mapa <- mapa %>% 
  addControl(
    html = '<div style="text-align: center; background-color: #fff; padding: 10px;"><h3>Mapa de las AGEB de Guadalajara</h3></div>',
    position = "topright"  # Cambia la posición del título si es necesario
  )

# Mostrar el mapa interactivo
mapa


# Unir las dos tablas
capa_ageb <- capa_ageb %>%
  left_join(db, by="CLAVE")


# Crear una paleta de colores para representar la población de las AGEB
pal <- colorQuantile("YlOrRd", domain = capa_ageb$Población.total, n=5)

# Crear un mapa interactivo con Leaflet
mapa <- leaflet(capa_ageb) %>%
  addTiles() %>%
  addPolygons(
    fillColor =  ~pal(Población.total),
    fillOpacity = 0.5,
    color = "black",
    weight = 1,
    popup = ~paste("Población: ", Población.total, " habitantes", "<br>", "AGEB: ", CLAVE, "<br>", "Municipio: ", NOM_MUN),
    label = ~NOM_MUN
  ) %>%
  addLegend(
    pal = pal,
    values = ~Población.total,
    title = "Densidad de Población",
    opacity = 1,
    position = "bottomright"
  ) %>%
  setView(lng = longitud, lat = latitud, zoom = zoom)  # Establece el centro y el nivel de zoom


# Agregar un título utilizando etiquetas HTML en la leyenda
mapa <- mapa %>% 
  addControl(
    html = '<div style="text-align: center; background-color: #fff; padding: 10px;"><h3>Mapa de población por AGEB de Jalisco</h3></div>',
    position = "topright"
  )

# Mostrar el mapa interactivo
mapa



